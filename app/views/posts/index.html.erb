<div style="max-width: 650px; margin: 0 auto; padding: 20px; font-family: sans-serif;"> 
  
  <!-- Navigation Header Row -->
  <div style="display: flex; align-items: center; gap: 12px; border-bottom: 2px solid var(--border-input); padding-bottom: 14px; margin-bottom: 20px;"> 
    <%= link_to "← Sanctuary", authenticated_root_path, style: "font-size: 14px; color: var(--text-muted); text-decoration: none; font-weight: 500; background: var(--bg-main); padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border-input);" %> 
    <h2 style="margin: 0; color: var(--text-body); font-size: 22px; font-weight: 700;">Agora of Athens</h2> 
  </div> 

  <!-- Posts Container Grid -->
  <div style="display: flex; flex-direction: column; gap: 20px;"> 
    <% if @posts.any? %> 
      <% @posts.each_with_index do |post, index| %> 
        <%= render partial: "posts/post", locals: { post: post, index: index } %> 
      <% end %> 
    <% else %> 
      <!-- Zero State Placeholder --> 
      <p style="color: var(--text-muted); font-style: italic; text-align: center; padding: 40px 0;">No mortal deeds have been recorded here yet.</p> 
    <% end %> 
  </div> 
</div>