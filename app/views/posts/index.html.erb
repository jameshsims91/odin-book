<div style="max-width: 650px; margin: 0 auto; padding: 20px; font-family: sans-serif;">
  
  <div style="display: flex; align-items: center; gap: 12px; border-bottom: 2px solid #eaeaea; padding-bottom: 14px; margin-bottom: 20px;">
    <%= link_to "← Dashboard", authenticated_root_path, style: "font-size: 14px; color: #4b5563; text-decoration: none; font-weight: 500; background: #f3f4f6; padding: 6px 12px; border-radius: 6px;" %>
    <h2 style="margin: 0; color: #111827; font-size: 22px; font-weight: 700;">Global Feed</h2>
  </div>

  <div style="display: flex; flex-direction: column; gap: 20px;">
    <% if @posts.any? %>
      <% @posts.each_with_index do |post, index| %>
        <%= render partial: "posts/post", locals: { post: post, index: index } %>
      <% end %>
    <% else %>
      <!-- Zero State Placeholder -->
      <p style="color: #6b7280; font-style: italic; text-align: center; padding: 40px 0;">No posts have been published yet.</p>
    <% end %>
  </div>

</div>