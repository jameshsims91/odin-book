
<div style="max-width: 650px; margin: 0 auto; padding: 20px; font-family: sans-serif;">

  <!-- Header Bar -->
  <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid var(--border-input); padding-bottom: 14px; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">

    <div style="display: flex; align-items: center; gap: 12px;">
      <%= link_to "← Dashboard", authenticated_root_path,
          style: "font-size: 14px; color: var(--text-muted); text-decoration: none; font-weight: 500; background: var(--bg-surface); border: 1px solid var(--border-input); padding: 6px 12px; border-radius: 6px;" %>

      <h2 style="margin: 0; color: var(--text-body); font-size: 22px; font-weight: 700;">
        Hermes' Scroll
      </h2>
    </div>

    <% if @notifications.any? && !demo_mode? %>
      <%= button_to clear_all_notifications_path,
          method: :delete,
          data: { confirm: "Command Hermes to empty his scroll?" },
          style: "font-size: 13px; color: #ef4444; background: rgba(239, 68, 68, 0.1); border: 1px solid #dc2626; padding: 6px 14px; border-radius: 6px; font-weight: 600; cursor: pointer; transition: all 0.2s;" do %>
        🗑️ Clear All
      <% end %>
    <% end %>

  </div>

  <!-- Notification Activity Stream -->
  <div style="display: flex; flex-direction: column; gap: 12px;">

    <% if @notifications.any? %>

      <% @notifications.each do |notification| %>

        <% icon, message_suffix = case notification.action
           when "liked_post"
             ["❤️", "strengthened your thread."]
           when "commented_on_post"
             ["💬", "casted an echo upon your manifestation."]
           when "friend_request"
             ["👥", "wishes to knot their fate with yours."]
           else
             ["✨", "interacted with your profile."]
           end %>

        <% unread = notification.read_at_was.nil? %>

        <% indicator_color = unread ? "var(--accent-primary)" : "var(--border-input)" %>

        <!-- Notification Card -->
        <div class="notification-card"
             style="background: var(--bg-surface);
                    border: 1px solid var(--border-input);
                    border-left: 4px solid <%= indicator_color %>;
                    border-radius: 12px;
                    padding: 16px;
                    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 12px;
                    transition: background-color 0.4s ease, border-color 0.3s ease;">

          <!-- Avatar and Notification Content -->
          <div style="display: flex; align-items: center; gap: 12px; min-width: 0; flex-grow: 1;">

            <!-- Actor Avatar -->
            <div class="notification-avatar"
                 style="position: relative; width: 40px; height: 40px; flex-shrink: 0;">

              <%= link_to user_profile_path(notification.actor),
                  style: "display: flex; text-decoration: none;" do %>

                <%= user_avatar(notification.actor, size: 40) %>

              <% end %>

              <!-- Notification Type Indicator -->
              <span style="position: absolute;
                           bottom: -3px;
                           right: -4px;
                           width: 20px;
                           height: 20px;
                           display: flex;
                           align-items: center;
                           justify-content: center;
                           font-size: 11px;
                           background: var(--bg-surface);
                           border: 1px solid var(--border-input);
                           border-radius: 50%;
                           pointer-events: none;">

                <%= icon %>

              </span>

            </div>

            <!-- Notification Message -->
            <div style="font-size: 14px;
                        color: var(--text-body);
                        min-width: 0;
                        overflow-wrap: anywhere;
                        flex-grow: 1;">

              <%= link_to (notification.actor.name.presence || notification.actor.email),
                  user_profile_path(notification.actor),
                  style: "font-weight: bold; color: var(--accent-primary); text-decoration: none;" %>

              <span style="color: var(--text-muted);">
                <%= message_suffix %>
              </span>

              <!-- Timestamp -->
              <span style="font-size: 11px;
                           color: var(--text-muted);
                           display: block;
                           margin-top: 4px;">

                <%= time_ago_in_words(notification.created_at) %> ago

              </span>

            </div>

          </div>

          <!-- Contextual Navigation -->
          <% if %w[liked_post commented_on_post].include?(notification.action) %>

            <%= link_to "Observe Threads →",
                authenticated_root_path,
                style: "font-size: 12px; color: var(--accent-primary); text-decoration: none; font-weight: 500; white-space: nowrap; flex-shrink: 0;" %>

          <% else %>

            <% if current_user.profile %>
              <%= link_to "Consult with Hermes →",
                  profile_path(current_user.profile),
                  style: "font-size: 12px; color: var(--accent-primary); text-decoration: none; font-weight: 500; white-space: nowrap; flex-shrink: 0;" %>
            <% end %>

          <% end %>

        </div>

      <% end %>

    <% else %>

      <!-- Empty Notification State -->
      <p style="color: var(--text-muted);
                font-style: italic;
                text-align: center;
                padding: 40px 0;
                background: var(--bg-surface);
                border: 1px dashed var(--border-input);
                border-radius: 12px;
                font-size: 14px;">

        No ripples in the timeline have occurred.

      </p>

    <% end %>

  </div>

</div>
