<div style="max-width: 400px; margin: 60px auto; padding: 30px; background: var(--card-bg); border: 1px solid var(--border-primary); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); font-family: sans-serif; transition: background 0.2s, border-color 0.2s;"> 
  <h2 style="margin: 0 0 24px 0; text-align: center; color: var(--text-dark); font-size: 22px; font-weight: 700;">Change your password</h2> 
  
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, style: "display: flex; flex-direction: column; gap: 16px;" }) do |f| %> 
    <%= render "devise/shared/error_messages", resource: resource %> 
    <%= f.hidden_field :reset_password_token %> 

    <!-- New Password Field --> 
    <div style="display: flex; flex-direction: column; gap: 6px;"> 
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <%= f.label :password, "New password", style: "font-size: 13px; font-weight: 600; color: var(--text-body);" %> 
        <% if @minimum_password_length %> 
          <span style="font-size: 11px; color: var(--text-light); font-style: italic;"><%= @minimum_password_length %> chars min</span> 
        <% end %> 
      </div>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", style: "border: 1px solid var(--border-input); border-radius: 8px; padding: 10px 12px; font-size: 14px; outline: none; background: var(--card-bg); color: var(--text-body); width: 100%; box-sizing: border-box;" %> 
    </div> 

    <!-- Confirm Password Field --> 
    <div style="display: flex; flex-direction: column; gap: 6px;"> 
      <%= f.label :password_confirmation, "Confirm new password", style: "font-size: 13px; font-weight: 600; color: var(--text-body);" %> 
      <%= f.password_field :password_confirmation, autocomplete: "new-password", style: "border: 1px solid var(--border-input); border-radius: 8px; padding: 10px 12px; font-size: 14px; outline: none; background: var(--card-bg); color: var(--text-body); width: 100%; box-sizing: border-box;" %> 
    </div> 

    <!-- Submit Trigger Button --> 
    <div style="margin-top: 8px;"> 
      <%= f.submit "Change my password", style: "width: 100%; background-color: #2563eb; color: white; font-weight: 600; padding: 10px; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; transition: background 0.2s;" %> 
    </div> 
  <% end %> 

  <!-- Footnote Shared Devise Links --> 
  <div style="margin-top: 24px; text-align: center; font-size: 13px; color: var(--text-muted); border-top: 1px solid var(--border-primary); padding-top: 16px;"> 
    <%= render "devise/shared/links" %> 
  </div> 
</div>
