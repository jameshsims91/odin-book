<style>
  /* Standard style setup for the full-width grid cards */
  .greek-grid-card:hover .laurel-leaf {
    border-color: var(--accent-primary, #1877f2) !important;
  }

  /* Target and style the native Pagy container wrapper */
  .greek-pagination-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 45px;
    margin: 0 auto;
  }

  /* Interactive hover rules for the pagination container foliage */
  .greek-pagination-wrapper:hover .laurel-leaf {
    border-color: var(--accent-primary, #1877f2) !important;
  }
</style>

<div style="max-width: 1200px; margin: 40px auto; padding: 30px; background: var(--card-bg); border: 1px solid var(--border-primary); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); font-family: sans-serif; box-sizing: border-box; transition: background 0.2s, border-color 0.2s; width: 95%;">
  
  <!-- Header with Back Arrow on Left -->
  <div style="display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--border-secondary); padding-bottom: 14px; margin-bottom: 24px;">
    <%= link_to "← Dashboard", authenticated_root_path, style: "font-size: 13px; color: var(--text-muted); text-decoration: none; font-weight: 500; background: var(--border-secondary); padding: 6px 12px; border-radius: 6px;" %>
    <h2 style="margin: 0; color: var(--text-dark); font-size: 20px; font-weight: 700;">All Friends</h2>
  </div>

  <!-- Full-Width Responsive Responsive Grid Container -->
  <% if @friends.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 24px;">
      <% @friends.each do |friend| %>
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px; border: 1px solid var(--border-secondary); border-radius: 8px; background: var(--card-bg);">
          
          <%# Profile Link Wrapper %>
          <% target_path = friend.profile ? profile_path(friend.profile) : user_path(friend) %>
          <%= link_to target_path, class: "greek-grid-card", style: "display: flex; align-items: center; gap: 12px; text-decoration: none; flex-grow: 1; cursor: pointer; min-width: 0;" do %>
            
            <%# Relative Wrapper to Position the Card Side Wreaths %>
            <div style="position: relative; display: inline-flex; align-items: center; justify-content: center; padding: 0 25px; flex-shrink: 0;">
              
              <!-- Left Card Foliage -->
              <div style="position: absolute; left: 0; display: flex; flex-direction: column; gap: 4px; transform: rotate(-15deg) scale(0.85);">
                <div class="laurel-leaf" style="width: 12px; height: 7px; border-left: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-left-radius: 12px; transform: rotate(20deg); transition: border-color 0.2s;"></div>
                <div class="laurel-leaf" style="width: 14px; height: 8px; border-left: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-left-radius: 12px; transform: rotate(10deg); margin-left: -2px; transition: border-color 0.2s;"></div>
                <div class="laurel-leaf" style="width: 12px; height: 7px; border-left: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-left-radius: 12px; transform: rotate(0deg); transition: border-color 0.2s;"></div>
              </div>

              <%# Circular Avatar Block %>
              <div style="position: relative; width: 50px; height: 50px; border-radius: 50%; border: 2px solid var(--border-primary); padding: 3px; background: var(--card-bg, #fff); display: flex; align-items: center; justify-content: center; overflow: hidden; z-index: 2;">
                <% if respond_to?(:user_avatar) %>
                  <%= user_avatar(friend, size: 44) %>
                <% else %>
                  <div style="width: 100%; height: 100%; background-color: var(--border-secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 700; color: var(--text-muted);">
                    <%= (friend.name.presence || friend.email).upcase[0] %>
                  </div>
                <% end %>
              </div>

              <!-- Right Card Foliage -->
              <div style="position: absolute; right: 0; display: flex; flex-direction: column; gap: 4px; transform: rotate(15deg) scale(0.85);">
                <div class="laurel-leaf" style="width: 12px; height: 7px; border-right: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-right-radius: 12px; transform: rotate(-20deg); transition: border-color 0.2s;"></div>
                <div class="laurel-leaf" style="width: 14px; height: 8px; border-right: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-right-radius: 12px; transform: rotate(-10deg); margin-right: -2px; transition: border-color 0.2s;"></div>
                <div class="laurel-leaf" style="width: 12px; height: 7px; border-right: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-right-radius: 12px; transform: rotate(0deg); transition: border-color 0.2s;"></div>
              </div>

            </div>

            <%# Text Details Block %>
            <div style="min-width: 0; flex-grow: 1;">
              <div style="font-size: 14px; font-weight: 600; color: var(--text-dark); text-overflow: ellipsis; overflow: hidden; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.5px;">
                <%= friend.name.presence || friend.email %>
              </div>
              <div style="font-size: 12px; color: var(--text-light);">⚡ Mutual Friend</div>
            </div>
          <% end %>

          <%# Unfriend Button Action %>
          <% rel_record = Friendship.find_by(user_id: [current_user.id, friend.id], friend_id: [current_user.id, friend.id]) %>
          <% if rel_record %>
            <div style="flex-shrink: 0; margin-left: 8px;">
              <%= link_to "Unfriend", friendship_path(rel_record), method: :delete, data: { confirm: "Are you sure you want to remove this friend?" }, style: "font-size: 12px; color: #ef4444; text-decoration: none; font-weight: 500;" %>
            </div>
          <% end %>

        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State View -->
    <div style="text-align: center; padding: 40px 0; color: var(--text-light); font-size: 14px;">
      <span style="font-size: 24px; display: block; margin-bottom: 6px;">👥</span> No friends added yet.
    </div>
  <% end %>

  <!-- Pagy Pagination Footer Section Wrapper -->
  <% if @pagy && @pagy.pages > 1 %>
    <div style="display: flex; justify-content: center; border-top: 1px solid var(--border-primary); padding-top: 24px; margin-top: 24px;">
      
      <%# Outer structural positioning box for pagination layout leaves %>
      <div class="greek-pagination-wrapper">
        
        <!-- Left Footer Pagination Laurel Branch -->
        <div style="position: absolute; left: 0; display: flex; flex-direction: column; gap: 6px; transform: rotate(-15deg) scale(1.1);">
          <div class="laurel-leaf" style="width: 16px; height: 9px; border-left: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-left-radius: 12px; transform: rotate(20deg); transition: border-color 0.2s;"></div>
          <div class="laurel-leaf" style="width: 18px; height: 10px; border-left: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-left-radius: 12px; transform: rotate(10deg); margin-left: -2px; transition: border-color 0.2s;"></div>
          <div class="laurel-leaf" style="width: 16px; height: 9px; border-left: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-left-radius: 12px; transform: rotate(0deg); transition: border-color 0.2s;"></div>
        </div>

        <%# Nav links injection point %>
        <div class="pagy-custom-style" style="position: relative; z-index: 2;">
          <%== pagy_nav(@pagy) %>
        </div>

        <!-- Right Footer Pagination Laurel Branch -->
        <div style="position: absolute; right: 0; display: flex; flex-direction: column; gap: 6px; transform: rotate(15deg) scale(1.1);">
          <div class="laurel-leaf" style="width: 16px; height: 9px; border-right: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-right-radius: 12px; transform: rotate(-20deg); transition: border-color 0.2s;"></div>
          <div class="laurel-leaf" style="width: 18px; height: 10px; border-right: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-right-radius: 12px; transform: rotate(-10deg); margin-right: -2px; transition: border-color 0.2s;"></div>
          <div class="laurel-leaf" style="width: 16px; height: 9px; border-right: 3px solid var(--text-muted); border-bottom: 3px solid var(--text-muted); border-bottom-right-radius: 12px; transform: rotate(0deg); transition: border-color 0.2s;"></div>
        </div>

      </div>

    </div>
  <% end %>

</div>
