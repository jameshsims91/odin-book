<style>
  /* Standard style setup for the full-width grid cards */
  .greek-grid-card:hover .laurel-leaf {
    opacity: 1 !important;
    color: var(--accent-primary) !important;
  }

  /* Specific color override logic mapping gold shadows while using The Void */
  [data-theme="void"] .greek-grid-card:hover .laurel-leaf,
  [data-theme="void"] .greek-pagination-wrapper:hover .laurel-leaf,
  html:not([data-theme="ether"]) .greek-grid-card:hover .laurel-leaf,
  html:not([data-theme="ether"]) .greek-pagination-wrapper:hover .laurel-leaf {
    color: #f59e0b !important;
    filter: drop-shadow(0 0 5px rgba(245, 158, 11, 0.6)) !important;
  }

  /* Target and style the native Pagy container wrapper */
  .greek-pagination-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 55px;
    margin: 0 auto;
    user-select: none;
  }

  /* Interactive hover rules for the pagination container foliage */
  .greek-pagination-wrapper:hover .laurel-leaf {
    opacity: 1 !important;
    color: var(--accent-primary) !important;
  }
</style>

<div style="max-width: 1200px; margin: 40px auto; padding: 30px; background: var(--bg-surface); border: 1px solid var(--border-input); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); font-family: sans-serif; box-sizing: border-box; transition: background 0.4s, border-color 0.3s; width: 95%;">
  
  <!-- Header with Back Arrow on Left -->
  <div style="display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--border-input); padding-bottom: 14px; margin-bottom: 24px;">
    <%= link_to "← Sanctuary", authenticated_root_path, style: "font-size: 13px; color: var(--text-muted); text-decoration: none; font-weight: 500; background: var(--bg-main); padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border-input);" %>
    <h2 style="margin: 0; color: var(--text-body); font-size: 20px; font-weight: 700;">Allies</h2>
  </div>

  <!-- Full-Width Responsive Grid Container -->
  <% if @friends.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 16px; margin-bottom: 24px;">
      <% @friends.each do |friend| %>
        <div style="display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--border-input); border-radius: 8px; background: var(--bg-surface); width: 100%; box-sizing: border-box;">
          
          <%# Profile Link Wrapper %>
          <% target_path = friend.profile ? profile_path(friend.profile) : user_path(friend) %>
          <%= link_to target_path, class: "greek-grid-card", style: "display: flex; align-items: center; justify-content: space-between; padding: 12px; border-radius: 8px; text-decoration: none; color: inherit; width: 100%; box-sizing: border-box; transition: background 0.4s, border-color 0.3s;" do %>
            
            <div style="display: flex; align-items: center; gap: 12px; flex-grow: 1; min-width: 0;">
              <%# Relative Wrapper to Position the Card Side Wreaths %>
              <div style="position: relative; display: inline-flex; align-items: center; justify-content: center; padding: 0 28px; flex-shrink: 0; user-select: none;">
                
                <!-- LEFT LAUREL BRANCH -->
                <div style="position: absolute; left: 0; display: flex; flex-direction: column; gap: 6px; transform: rotate(-12deg) scale(0.95); align-items: flex-end;">
                  <div class="laurel-leaf" style="width: 14px; height: 8px; background: currentColor; border-radius: 100% 0% 100% 0%; transform: rotate(35deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                  <div class="laurel-leaf" style="width: 16px; height: 9px; background: currentColor; border-radius: 100% 0% 100% 0%; transform: rotate(15deg); margin-right: -3px; opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                  <div class="laurel-leaf" style="width: 14px; height: 8px; background: currentColor; border-radius: 100% 0% 100% 0%; transform: rotate(-5deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                </div>

                <%# Circular Avatar Block %>
                <div style="position: relative; width: 50px; height: 50px; border-radius: 50%; border: 2px solid var(--border-input); padding: 3px; background: var(--bg-surface); display: flex; align-items: center; justify-content: center; overflow: hidden; z-index: 2;">
                  <% if respond_to?(:user_avatar) %>
                    <%= user_avatar(friend, size: 44) %>
                  <% else %>
                    <div style="width: 100%; height: 100%; background-color: var(--bg-main); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 700; color: var(--text-muted);">
                      <%= (friend.name.presence || friend.email).upcase %>
                    </div>
                  <% end %>
                </div>

                <!-- RIGHT LAUREL BRANCH -->
                <div style="position: absolute; right: 0; display: flex; flex-direction: column; gap: 6px; transform: rotate(12deg) scale(0.95); align-items: flex-start;">
                  <div class="laurel-leaf" style="width: 14px; height: 8px; background: currentColor; border-radius: 0% 100% 0% 100%; transform: rotate(-35deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                  <div class="laurel-leaf" style="width: 16px; height: 9px; background: currentColor; border-radius: 0% 100% 0% 100%; transform: rotate(-15deg); margin-left: -3px; opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                  <div class="laurel-leaf" style="width: 14px; height: 8px; background: currentColor; border-radius: 0% 100% 0% 100%; transform: rotate(5deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                </div>

              </div>

              <%# Text Details Block %>
              <div style="min-width: 0; flex-grow: 1; padding-right: 8px;">
                <div style="font-size: 13px; font-weight: 600; color: var(--text-body); text-transform: uppercase; letter-spacing: 0.5px; word-break: break-word; line-height: 1.2; margin-bottom: 2px;">
                  <%= friend.name.presence || friend.email %>
                </div>
                <div style="font-size: 11px; color: var(--text-muted);">⚡ Mutual Ally</div>
              </div>
            </div>

            <%# Unfriend Button Action %>
            <% rel_record = Friendship.find_by(user_id: [current_user.id, friend.id], friend_id: [current_user.id, friend.id]) %>
            <% if rel_record %>
              <div style="flex-shrink: 0; margin-left: 8px; z-index: 5;">
                <%= link_to "Cast to Tartarus", friendship_path(rel_record), method: :delete, data: { confirm: "Are you sure you want to cast this deceiver into the deepest darkest pit of the Underworld?" }, style: "font-size: 12px; color: #dc2626; text-decoration: none; font-weight: 500;" %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State View -->
    <div style="text-align: center; padding: 40px 0; color: var(--text-muted); font-size: 14px;">
      <span style="font-size: 24px; display: block; margin-bottom: 6px;">👥</span> No allies added yet.
    </div>
  <% end %>

  <!-- Pagy Pagination Footer Section Wrapper -->
  <% if @pagy && @pagy.pages > 1 %>
    <div style="display: flex; justify-content: center; border-top: 1px solid var(--border-input); padding-top: 24px; margin-top: 24px;">
      
      <%# Outer structural positioning box for pagination layout leaves %>
      <div class="greek-pagination-wrapper">
        
        <!-- Left Footer Pagination Laurel Branch -->
        <div style="position: absolute; left: 0; display: flex; flex-direction: column; gap: 6px; transform: rotate(-12deg) scale(1.1); align-items: flex-end;">
          <div class="laurel-leaf" style="width: 16px; height: 9px; background: currentColor; border-radius: 100% 0% 100% 0%; transform: rotate(35deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
          <div class="laurel-leaf" style="width: 18px; height: 10px; background: currentColor; border-radius: 100% 0% 100% 0%; transform: rotate(15deg); margin-right: -3px; opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
          <div class="laurel-leaf" style="width: 16px; height: 9px; background: currentColor; border-radius: 100% 0% 100% 0%; transform: rotate(-5deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
        </div>

        <%# Nav links injection point %>
        <div style="z-index: 2;">
          <%== pagy_nav(@pagy) %>
        </div>

        <!-- Right Footer Pagination Laurel Branch -->
        <div style="position: absolute; right: 0; display: flex; flex-direction: column; gap: 6px; transform: rotate(12deg) scale(1.1); align-items: flex-start;">
          <div class="laurel-leaf" style="width: 16px; height: 9px; background: currentColor; border-radius: 0% 100% 0% 100%; transform: rotate(-35deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
          <div class="laurel-leaf" style="width: 18px; height: 10px; background: currentColor; border-radius: 0% 100% 0% 100%; transform: rotate(-15deg); margin-left: -3px; opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
          <div class="laurel-leaf" style="width: 16px; height: 9px; background: currentColor; border-radius: 0% 100% 0% 100%; transform: rotate(5deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
        </div>

      </div>
    </div>
  <% end %>

</div>
