<div class="friends-dashboard-widget" style="background: var(--bg-primary); border: 1px solid var(--border-secondary); border-radius: 12px; padding: 24px; font-family: sans-serif; box-sizing: border-box; text-align: center; color: var(--text-dark); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); transition: background 0.2s, border-color 0.2s;"> 
  
  <!-- Header Row with "Show All" Link --> 
  <div style="border-bottom: 1px solid var(--border-secondary); padding-bottom: 12px; margin-bottom: 20px;"> 
    <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); display: block; font-weight: bold; margin-bottom: 4px;">— Active Allies —</span>
    <h3 style="font-size: 20px; font-weight: 700; color: var(--text-dark); margin: 0; text-transform: uppercase; letter-spacing: 1px;"> 
      Friends (<%= active_friends.count %>) 
    </h3> 
    <%= link_to "Show All →", friends_path, style: "font-size: 13px; font-weight: 600; color: var(--accent-primary, #1877f2); text-decoration: none; display: inline-block; margin-top: 6px;" %> 
  </div> 

  <!-- Friends List Container (Limited to 4) --> 
  <div style="display: flex; flex-direction: column; gap: 16px;"> 
    <% if active_friends.any? %> 
      <% active_friends.first(4).each do |friend| %> 
        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding-bottom: 14px; border-bottom: 1px dashed var(--border-secondary);"> 
          
          <% target_path = friend.profile ? profile_path(friend.profile) : user_path(friend) %> 
          <%= link_to target_path, style: "display: flex; flex-direction: column; align-items: center; text-decoration: none; color: inherit; width: 100%;" do %> 
            
            <%# Circular Portrait Frame matching the site theme %>
            <div style="position: relative; width: 80px; height: 80px; border-radius: 50%; border: 2px solid var(--border-primary); padding: 4px; background: var(--card-bg, #fff); margin-bottom: 4px; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
              <% if respond_to?(:user_avatar) %> 
                <%= user_avatar(friend, size: 72) %> 
              <% else %> 
                <div style="width: 100%; height: 100%; background-color: var(--border-secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; color: var(--text-muted);"> 
                  <%= (friend.name.presence || friend.email).upcase[0] %> 
                </div> 
              <% end %> 
            </div>

            <div style="width: 100%;"> 
              <div class="friend-link-title" style="font-size: 15px; font-weight: 600; color: var(--text-dark); letter-spacing: 0.5px; text-transform: uppercase; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;"> 
                <%= friend.name.presence || friend.email %> 
              </div> 
              <div style="font-size: 12px; color: var(--text-light); margin-top: 2px;">⚡ Mutual Friend</div> 
            </div> 
          <% end %> 

          <% rel_record = Friendship.find_by(user_id: [profile_owner.id, friend.id], friend_id: [profile_owner.id, friend.id]) %> 
          <% if rel_record %> 
            <div style="margin-top: 2px;"> 
              <%= link_to "Unfriend", friendship_path(rel_record), method: :delete, data: { confirm: "Are you sure you want to remove this friend?" }, style: "font-size: 11px; color: #ef4444; text-decoration: none; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;" %> 
            </div> 
          <% end %> 
        </div> 
      <% end %> 
    <% else %> 
      <div style="text-align: center; padding: 24px 0; color: var(--text-light);"> 
        <span style="font-size: 28px; display: block; margin-bottom: 8px;">👥</span> No allies found yet. 
      </div> 
    <% end %> 
  </div> 
</div>