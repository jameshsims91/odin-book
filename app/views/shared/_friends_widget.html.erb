<style>
  /* Target the branch elements inside the card on hover */
  .greek-friend-card:hover .laurel-leaf {
    opacity: 1 !important;
    color: var(--accent-primary) !important;
  }

  /* Specific theme configuration for glowing gold leaves inside the Void layout sidebar */
  [data-theme="void"] .greek-friend-card:hover .laurel-leaf,
  html:not([data-theme="ether"]) .greek-friend-card:hover .laurel-leaf {
    color: #f59e0b !important;
    filter: drop-shadow(0 0 5px rgba(245, 158, 11, 0.6)) !important;
  }
</style>

<div class="friends-dashboard-widget" style="background: var(--bg-surface); border: 1px solid var(--border-input); border-radius: 12px; padding: 24px; font-family: sans-serif; box-sizing: border-box; text-align: center; color: var(--text-body); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); transition: background 0.4s, border-color 0.3s;"> 
  
  <!-- Header Row with "Show All" Link --> 
  <div style="border-bottom: 1px solid var(--border-input); padding-bottom: 12px; margin-bottom: 20px;"> 
    <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); display: block; font-weight: bold; margin-bottom: 4px;">— Active Allies —</span>
    <h3 style="font-size: 20px; font-weight: 700; color: var(--text-body); margin: 0; text-transform: uppercase; letter-spacing: 1px;"> 
      Allies (<%= profile_owner.all_friends.count %>) 
    </h3> 
    <%= link_to "Reveal All →", friends_path, style: "font-size: 13px; font-weight: 600; color: var(--accent-primary); text-decoration: none; display: inline-block; margin-top: 6px;" %> 
  </div> 

  <!-- Friends List Container (Strictly Capped at 4) --> 
  <div style="display: flex; flex-direction: column; gap: 20px;"> 
    <% if active_friends.any? %> 
      <% active_friends.first(4).each do |friend| %> 
        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding-bottom: 14px; border-bottom: 1px dashed var(--border-input);"> 
          
          <% target_path = friend.profile ? profile_path(friend.profile) : user_path(friend) %> 
          <%= link_to target_path, class: "greek-friend-card", style: "display: flex; flex-direction: column; align-items: center; text-decoration: none; color: inherit; width: 100%;" do %> 
            
            <%# Relative Wrapper to Position the Side Wreaths %>
            <div style="position: relative; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 6px; padding: 0 35px; user-select: none;">
              
              <!-- LEFT LAUREL BRANCH: Geometric teardrop-shaped leaves curving upward -->
              <div style="position: absolute; left: 0; display: flex; flex-direction: column; gap: 6px; transform: rotate(-12deg) scale(0.95); align-items: flex-end;">
                <div class="laurel-leaf" style="width: 14px; height: 8px; background: currentColor; border-radius: 100% 0% 100% 0%; transform: rotate(35deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                <div class="laurel-leaf" style="width: 16px; height: 9px; background: currentColor; border-radius: 100% 0% 100% 0%; transform: rotate(15deg); margin-right: -3px; opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                <div class="laurel-leaf" style="width: 14px; height: 8px; background: currentColor; border-radius: 100% 0% 100% 0%; transform: rotate(-5deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
              </div>

              <%# Circular Portrait Frame %>
              <div style="position: relative; width: 80px; height: 80px; border-radius: 50%; border: 2px solid var(--border-input); padding: 4px; background: var(--bg-surface); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; z-index: 2;">
                <% if respond_to?(:user_avatar) %> 
                  <%= user_avatar(friend, size: 72) %> 
                <% else %> 
                  <div style="width: 100%; height: 100%; background-color: var(--bg-main); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; color: var(--text-muted); border: 1px solid var(--border-input);"> 
                    <%= (friend.name.presence || friend.email).upcase[0] %> 
                  </div> 
                <% end %> 
              </div>

              <!-- RIGHT LAUREL BRANCH: Geometric teardrop-shaped leaves mirroring the left configuration -->
              <div style="position: absolute; right: 0; display: flex; flex-direction: column; gap: 6px; transform: rotate(12deg) scale(0.95); align-items: flex-start;">
                <div class="laurel-leaf" style="width: 14px; height: 8px; background: currentColor; border-radius: 0% 100% 0% 100%; transform: rotate(-35deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                <div class="laurel-leaf" style="width: 16px; height: 9px; background: currentColor; border-radius: 0% 100% 0% 100%; transform: rotate(-15deg); margin-left: -3px; opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
                <div class="laurel-leaf" style="width: 14px; height: 8px; background: currentColor; border-radius: 0% 100% 0% 100%; transform: rotate(5deg); opacity: 0.5; color: var(--text-muted); transition: all 0.3s ease;"></div>
              </div>

            </div>

            <div style="width: 100%;"> 
              <div class="friend-link-title" style="font-size: 15px; font-weight: 600; color: var(--text-body); letter-spacing: 0.5px; text-transform: uppercase; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;"> 
                <%= friend.name.presence || friend.email %> 
              </div> 
              <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">⚡ Mutual Ally</div> 
            </div> 
          <% end %> 

          <% rel_record = Friendship.find_by(user_id: [profile_owner.id, friend.id], friend_id: [profile_owner.id, friend.id]) %> 
          <% if rel_record %> 
            <div style="margin-top: 2px; z-index: 5; position: relative;"> 
              <%= link_to "Cast to Tartarus", friendship_path(rel_record), method: :delete, data: { confirm: "Are you sure you want to cast this deceiver into the deepest darkest pit of the Underworld?" }, style: "font-size: 11px; color: #dc2626; text-decoration: none; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;" %> 
            </div> 
          <% end %> 
        </div> 
      <% end %> 
    <% else %> 
      <div style="text-align: center; padding: 24px 0; color: var(--text-muted);"> 
        <span style="font-size: 28px; display: block; margin-bottom: 8px;">👥</span> No allies found yet. 
      </div> 
    <% end %> 
  </div> 
</div>
